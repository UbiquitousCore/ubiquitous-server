# Secrets for local runs: copy to .env (git-ignored) and change every value.
# Docker compose reads this file. Game settings (ports, bots, festival items)
# live in server.json, which `just dev` and `just up` both read; anything set
# here still wins over it, and leaving a variable unset or empty lets
# server.json speak. For production, either export real values in the
# environment or keep them in .env.production and run
# `just up .env.production`.
POSTGRES_PASSWORD=change-me

UBIQUITOUS_DEVELOPMENT_ACCOUNTS=false
UBIQUITOUS_DEVELOPMENT_USER_ID=developer
UBIQUITOUS_DEVELOPMENT_PASS_HASH=
UBIQUITOUS_DEVELOPMENT_SECOND_USER_ID=developer2
UBIQUITOUS_DEVELOPMENT_SECOND_PASS_HASH=

# Playerbots (modules/playerbots/README.md). Prefer server.json for these;
# set them here only to override it for one environment.
# UBIQUITOUS_MODULE_PLAYERBOTS_ENABLED=false
# UBIQUITOUS_MODULE_PLAYERBOTS_RANDOM_BOT_COUNT=5

# Seasonal content. Prefer server.json; set here only to override it.
# UBIQUITOUS_FESTIVAL_CONTENT_ENABLED=true

# Where `just ingest` looks for a dropped-in client build (.env is read by
# just too, so this applies there as well as in the shell).
# UBIQUITOUS_INCOMING_DIR=incoming
