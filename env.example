# Optional settings. The first import writes this file as .env (git-ignored)
# beside docker-compose.yml, with your setup answers filled in; or copy it.
# The server reads every UBIQUITOUS_* line itself as it starts, in Docker and
# in a native run. Nothing here is required; Docker generates the database
# password on its own. Apply changes with `docker compose restart server`, or
# the admin page's Restart button; UBIQUITOUS_SITE and the ports need
# `docker compose up -d`. Game settings (ports,
# bots, festival items) live in server.json; anything set here wins over it,
# and leaving a variable unset or empty lets server.json speak.

# The address other devices open: this machine's LAN address, or a domain
# with ports 80 and 443 forwarded here. localhost always works too.
# UBIQUITOUS_SITE=192.168.1.20
# UBIQUITOUS_HTTPS_PORT=443
# UBIQUITOUS_HTTP_PORT=80

# Open the admin page to other devices on this network, at
# https://<UBIQUITOUS_SITE>:8443 (UBIQUITOUS_ADMIN_HTTPS_PORT). Unset, only
# this machine can open it, at http://localhost:8790.
# UBIQUITOUS_ADMIN_PUBLISH_ADDRESS=0.0.0.0
# UBIQUITOUS_ADMIN_HTTPS_PORT=8443

# Use server.json in the Docker stack too (Windows: separate with ;).
# COMPOSE_FILE=docker-compose.yml:docker-compose.server-json.yml

# Linux: your own ids (id -u, id -g), so files the import writes are yours.
# UBIQUITOUS_UID=1000
# UBIQUITOUS_GID=1000

# ---- File saves only (dotnet run, docker compose up dev) ---------------------
# Ignored with Postgres, so never in the Docker stack: there the server has no
# development logins and `dev.enterWorld` is refused. Make real accounts
# instead: `docker compose exec server dotnet server.dll account create <name>`.
#
# Dev mode extras (all off unless the line below is true):
#   - two ready-made logins, each with two level-60 characters, every spell
#     rank and a full talent build, and a large purse
#   - both logins are GMs (admin teleport, operator spells, no movement checks)
#   - dev.enterWorld, so tools and tests can skip login
# They stay available alongside any real accounts you make (real ones are
# numbered from 100, so ids never clash). Never enable on a shared server.
UBIQUITOUS_DEVELOPMENT_ACCOUNTS=false
# A login only exists while its PASS_HASH (really the password you type) is set.
UBIQUITOUS_DEVELOPMENT_USER_ID=developer
UBIQUITOUS_DEVELOPMENT_PASS_HASH=
UBIQUITOUS_DEVELOPMENT_SECOND_USER_ID=developer2
UBIQUITOUS_DEVELOPMENT_SECOND_PASS_HASH=
# ---- end file saves only ----------------------------------------------------

# Playerbots (modules/playerbots/README.md). Prefer server.json for these;
# set them here only to override it for one environment.
# UBIQUITOUS_MODULE_PLAYERBOTS_ENABLED=false
# UBIQUITOUS_MODULE_PLAYERBOTS_RANDOM_BOT_COUNT=5

# Seasonal events (winter solstice and anniversary scenery, creatures and items).
# Off by default; true turns them on. Prefer server.json; this overrides it
# everywhere.
# UBIQUITOUS_FESTIVAL_CONTENT_ENABLED=false

# Rates. 1 is the game as it plays; each is a multiplier, so 1.5 is half as
# much again and 0.5 is half. Prefer server.json; this overrides it everywhere.
# UBIQUITOUS_XP_RATE=1
# UBIQUITOUS_PLAYER_DAMAGE_RATE=1
# UBIQUITOUS_CREATURE_DAMAGE_RATE=1
# UBIQUITOUS_CREATURE_HEALTH_RATE=1
# How much Legend exhaustion a player can build up in a day before Legend
# dungeons turn them away.
# UBIQUITOUS_EXHAUSTION_LIMIT=100

# Stop at start when no imported data package is found, instead of running on
# development content. The Docker stack sets it; a native run does not.
# UBIQUITOUS_REQUIRE_DATA_PACKAGE=true

# Limits and logging (defaults shown).
# UBIQUITOUS_MAX_CONNECTIONS=500
# UBIQUITOUS_MAX_MESSAGES_PER_SECOND=30
# UBIQUITOUS_LOG_LEVEL=Information
# Race ids that cannot be picked at character creation, comma-separated;
# none opens every race. Unset, Mendel (7) is closed: 1.1.4 cannot play it.
# UBIQUITOUS_DISABLED_RACES=7
# Page origins allowed to open the game socket, comma-separated; empty allows any.
# UBIQUITOUS_ALLOWED_ORIGINS=
# Festival scenery and creatures by entry id, overriding the built-in lists.
# UBIQUITOUS_FESTIVAL_STATIC_ENTRIES=
# UBIQUITOUS_FESTIVAL_CREATURE_ENTRIES=

# Docker publishes the port on loopback only. Set 0.0.0.0 to serve a LAN
# (and then turn the development logins off).
# UBIQUITOUS_PUBLISH_ADDRESS=127.0.0.1
