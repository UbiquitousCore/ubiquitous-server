# Secrets for local runs: copy to .env (git-ignored) and change every value.
# Docker compose reads this file. Game settings (ports, bots, festival items)
# live in server.json, which `just dev` and `just up` both read; anything set
# here still wins over it, and leaving a variable unset or empty lets
# server.json speak. For production, either export real values in the
# environment or keep them in .env.production and run
# `just up .env.production`.
POSTGRES_PASSWORD=change-me

# ---- Dev mode only ----------------------------------------------------------
# Dev mode is `just dev`: the server runs on your machine with saves as
# editable JSON files in data/generated, no Docker, no Postgres.
#   ./setup.sh        once (fills in the login below for you)
#   just dev          start the server (rebuilds on every start)
#   just dev --port 9000
# Everything in this block is ignored by the Docker stack (`just up`,
# `./run.sh`): with Postgres the server has no development logins, and
# `dev.enterWorld` (join as any character by id, no password) is refused. Make
# real accounts instead: `./run.sh account create <name>`.
#
# Dev mode extras (all off unless the line below is true):
#   - two ready-made logins, each with two level-60 characters, every spell
#     rank and a full talent build, and a large purse
#   - both logins are GMs (admin teleport, operator spells, no movement checks)
#   - dev.enterWorld, so tools and tests can skip login
# They exist only until you create a real account (`just account create <name>`),
# which switches the server to your own accounts file. Never enable on a shared
# server.
UBIQUITOUS_DEVELOPMENT_ACCOUNTS=false
# A login only exists while its PASS_HASH (really the password you type) is set.
UBIQUITOUS_DEVELOPMENT_USER_ID=developer
UBIQUITOUS_DEVELOPMENT_PASS_HASH=
UBIQUITOUS_DEVELOPMENT_SECOND_USER_ID=developer2
UBIQUITOUS_DEVELOPMENT_SECOND_PASS_HASH=
# ---- end dev mode only ------------------------------------------------------

# Playerbots (modules/playerbots/README.md). Prefer server.json for these;
# set them here only to override it for one environment.
# UBIQUITOUS_MODULE_PLAYERBOTS_ENABLED=false
# UBIQUITOUS_MODULE_PLAYERBOTS_RANDOM_BOT_COUNT=5

# Seasonal content. Prefer server.json; set here only to override it.
# UBIQUITOUS_FESTIVAL_CONTENT_ENABLED=true

# Where `just ingest` looks for a dropped-in client build (.env is read by
# just too, so this applies there as well as in the shell).
# UBIQUITOUS_INCOMING_DIR=incoming

# Docker publishes the port on loopback only. Set 0.0.0.0 to serve a LAN
# (and then turn the development logins off).
# UBIQUITOUS_PUBLISH_ADDRESS=127.0.0.1
