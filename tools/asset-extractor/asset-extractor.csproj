<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="DotRecast.Core" />
    <PackageReference Include="DotRecast.Recast" />
    <PackageReference Include="DotRecast.Detour" />
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\data\data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Written out as `.env` by the first import; see SettingsFile. -->
    <EmbeddedResource Include="host-env.template" LogicalName="host-env.template" />
    <!-- One per build whose table shapes were captured; see KnownBuilds. -->
    <EmbeddedResource Include="fingerprints\*.json" LogicalName="fingerprints/%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
</Project>
